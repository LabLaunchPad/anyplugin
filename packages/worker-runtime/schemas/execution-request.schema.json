{
  "$id": "https://lablaunchpad.dev/worker-runtime/1.3.0/execution-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Worker Runtime frozen contract: ExecutionRequest (contract version 1.3.0).",
  "properties": {
    "argv": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "contractVersion": {
      "const": "1.3.0",
      "type": "string"
    },
    "cwd": {
      "minLength": 1,
      "type": "string"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^EXE-[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "maxArtifactBytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "maxArtifacts": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "maxOutputBytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "timeoutMs": {
          "exclusiveMinimum": 0,
          "maximum": 86400000,
          "type": "integer"
        }
      },
      "required": [
        "timeoutMs",
        "maxOutputBytes",
        "maxArtifactBytes",
        "maxArtifacts"
      ],
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "captureArtifacts": {
          "type": "boolean"
        },
        "confineCwd": {
          "type": "boolean"
        },
        "envAllowlist": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "envAllowlist",
        "confineCwd",
        "captureArtifacts"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "contractVersion",
    "argv",
    "cwd",
    "env",
    "limits",
    "policy"
  ],
  "title": "ExecutionRequest",
  "type": "object",
  "x-semanticAuthority": "@lablaunchpad/worker-runtime contracts (zod)",
  "x-validationMode": "STRUCTURAL_SCHEMA_VALID"
}
