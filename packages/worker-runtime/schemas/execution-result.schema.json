{
  "$id": "https://lablaunchpad.dev/worker-runtime/1.3.0/execution-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Worker Runtime frozen contract: ExecutionResult (contract version 1.3.0).",
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "contentHash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "contentHash",
          "bytes",
          "truncated"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "contractVersion": {
      "const": "1.3.0",
      "type": "string"
    },
    "exitCode": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "pattern": "^EXE-[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "envKeys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "maxArtifactBytes": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxArtifacts": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxOutputBytes": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "timeoutMs": {
              "exclusiveMinimum": 0,
              "maximum": 86400000,
              "type": "integer"
            }
          },
          "required": [
            "timeoutMs",
            "maxOutputBytes",
            "maxArtifactBytes",
            "maxArtifacts"
          ],
          "type": "object"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "captureArtifacts": {
              "type": "boolean"
            },
            "confineCwd": {
              "type": "boolean"
            },
            "envAllowlist": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "envAllowlist",
            "confineCwd",
            "captureArtifacts"
          ],
          "type": "object"
        }
      },
      "required": [
        "argv",
        "cwd",
        "envKeys",
        "limits",
        "policy"
      ],
      "type": "object"
    },
    "signal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
