{
  "name": "@lablaunchpad/core",
  "version": "0.1.1",
  "description": "Core runtime: agent/environment detection, canonical plugin schema, event mapping, OKF v0.2 library.",
  "license": "MIT",
  "author": {
    "name": "Rahul Paul",
    "url": "https://github.com/LabLaunchPad"
  },
  "homepage": "https://github.com/LabLaunchPad/anyplugin/tree/main/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LabLaunchPad/anyplugin.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/LabLaunchPad/anyplugin/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detect": {
      "types": "./dist/detect/index.d.ts",
      "default": "./dist/detect/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./okf": {
      "types": "./dist/okf/index.d.ts",
      "default": "./dist/okf/index.js"
    },
    "./emit": {
      "types": "./dist/emit/index.d.ts",
      "default": "./dist/emit/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
